# Impostazioni facoltative: copia questo file in .env e modifica i valori (il file .env non va nel
# repository). Senza .env il sito parte comunque con `docker compose up --build`.

# ---------- Produzione con HTTPS (RNF-S01) ----------
# Dominio del sito: Caddy ottiene il certificato HTTPS. Si usa con: docker compose --profile https up -d --build
# DOMINIO=tridentum.esempio.it
# Indirizzo pubblico del sito, usato nei link delle e-mail e per i cookie sicuri: con il proxy HTTPS è https://DOMINIO
# INDIRIZZO_PUBBLICO=https://tridentum.esempio.it
# Con il proxy HTTPS: 1 proxy davanti al sito, e la porta 3000 chiusa verso l'esterno
# PROXY_FIDATI=1
# PORTA_APP=127.0.0.1:3000

# ---------- Mappa ----------
# Sfondo "dataviz-light" di MapTiler, senza negozi e bar. La chiave del progetto è già nel codice
# (frontend/src/lib/sfondo.js): qui serve solo per usarne un'altra (https://cloud.maptiler.com), oppure
# "nessuna" per tornare ai tile standard di OpenStreetMap. In sviluppo si può mettere in frontend/.env.local.
# VITE_MAPTILER_KEY=

# ---------- Privacy (RNF-S04) ----------
# Indirizzo e-mail a cui gli utenti scrivono per i diritti sui dati personali: compare nell'informativa
EMAIL_PRIVACY=

# ---------- E-mail ----------
# Server per l'invio delle e-mail, es. smtps://utente:password@smtp.esempio.it:465
# Senza, le e-mail non partono: per il primo amministratore usa
#   docker compose exec app npm run crea-amministratore -- tua@email.it
SMTP_URL=

# ---------- Segreti ----------
# Password del database PostgreSQL (il database non è raggiungibile dall'esterno)
DB_PASSWORD=tridentum
# Segreto per firmare i token (almeno 32 caratteri). Facoltativo: se manca, il server ne crea uno
# casuale al primo avvio e lo conserva nel volume dei dati.
JWT_SEGRETO=

# "si" per avere account e ricordi di prova (solo per dimostrazioni, mai in produzione)
DATI_DIMOSTRATIVI=no
