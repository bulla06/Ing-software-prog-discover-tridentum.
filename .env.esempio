# Copia questo file in .env e modifica i valori (il file .env non va nel repository).

# Segreto per firmare i token di accesso: almeno 32 caratteri casuali.
# Per generarne uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGRETO=

# Password del database PostgreSQL
DB_PASSWORD=tridentum

# Indirizzo pubblico del sito, usato nei link delle e-mail (con https:// in produzione)
INDIRIZZO_PUBBLICO=http://localhost:3000

# Numero di proxy davanti al sito (1 se c'è un proxy HTTPS, 0 se il sito è raggiungibile direttamente)
PROXY_FIDATI=0

# Server per l'invio delle e-mail, es. smtps://utente:password@smtp.esempio.it:465
# Senza, le e-mail non partono: per il primo amministratore usa
#   docker compose exec app npm run crea-amministratore -- tua@email.it
SMTP_URL=

# "si" per avere account e ricordi di prova (solo per dimostrazioni, mai in produzione)
DATI_DIMOSTRATIVI=no
